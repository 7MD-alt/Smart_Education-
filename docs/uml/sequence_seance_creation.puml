@startuml CampusEye_Sequence_SeanceCreation
title Séance Creation — Manual Form and via NOVAA

autonumber
skinparam responseMessageBelowArrow true

' ════════════════════ A. Manual creation (teacher form) ════════════════════
mainframe A : Manual creation (teacher form)

actor Teacher as T
participant "SeancesPage\n(React)" as UI
participant "SeanceListCreateAPIView" as API
participant "Seance model" as M
database "Database" as DB
participant "Notification\nservice" as N

T -> UI : Open "Nouvelle séance", fill date/time/type/group
note over T, UI
  Code de présence — optional
  (auto-generated if left empty)
end note
T -> UI : Submit
UI -> API : POST /teacher/courses/{course_id}/seances/ {form}

API -> API : Verify course belongs to teacher
alt not owner / not found
  API --> UI : 403 / 404
else authorized
  API -> API : Parse date + start_time
  API -> API : code = form.check_in_code OR generate_seance_code()
  alt TP with "both groups"
    API -> M : create Seance(GROUP_A, code)
    API -> M : create Seance(GROUP_B, code)
  else single séance
    API -> M : create Seance(code, ...)
  end
  M -> DB : INSERT séance(s)
  DB --> M : saved
  API -> API : Auto-activate if start within 5 min
  API -> N : Notify eligible students (NO code in payload)
  N -> DB : INSERT notifications
  API --> UI : 201 [ seance + check_in_code ] (teacher-facing)
  UI --> T : Show séance + code to read out in class
end

newpage

' ════════════════════ B. Creation via NOVAA (natural language) ════════════════════
mainframe B : Creation via NOVAA (natural language)

actor Teacher as T2
participant "NOVAA chat" as UI2
participant "ask_novaa()" as ASK
participant "Intent router" as R
participant "execute_novaa_action()" as X
participant "create_seance()\n(action executor)" as AE
database "Database" as DB2

T2 -> UI2 : "programme une séance demain à 10h pour Réseaux"
UI2 -> ASK : POST /ai/ask (question, role=TEACHER)
ASK -> R : detect_intent()
R --> ASK : intent = create_seance
ASK -> ASK : extract_action_params()\n{course, date, time, ...}
ASK -> X : execute_novaa_action(create_seance, params)
X -> X : Role guard (TEACHER only)
X -> AE : create_seance(teacher, course, date, time)
AE -> AE : Resolve course, parse date/time
AE -> AE : code = generate_seance_code()
AE -> DB2 : INSERT Seance(check_in_code = code)
DB2 --> AE : saved
AE --> X : ok {message incl. code, seance_id}
X --> ASK : result
ASK --> UI2 : answer (shows code to teacher)
UI2 --> T2 : Séance créée — Code: XXXXXX

@enduml
